      "content": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<preferences xmlns:android=\"http://schemas.android.com/apk/res/android\">\n    <preferenceCategory android:title=\"Edge Panel Suite\">\n        <SwitchPreferenceCheckBox android:key=\"enable_edge_panel\", android:title=\"Enable Edge Panel\", android:summary=\"Quick access to app settings\" android:defaultValue=\"true\" />\n        <SwitchPreferenceCheckBox android:key=\"edge_panel_overlay\", android:title=\"Enable Panel Overlay\", android:summary=\"Allow panel to draw over other apps\" android:defaultValue=\"true\" />\n    </preferenceCategory>\n    <preferenceCategory android:title=\"Shared Storage &amp; Downloads\">\n        <SwitchPreferenceCheckBox android:key=\"access_downloads\", android:title=\"Direct Downloads Access\", android:summary=\"Direct path to /sdcard/Download\" android:defaultValue=\"true\" />\n        <SwitchPreferenceCheckBox android:key=\"manage_external_storage\", android:title=\"Manage All Files\", android:summary=\"Full access to external storage (MANAGE_EXTERNAL_STORAGE)\" android:defaultValue=\"true\" />\n        <SwitchPreferenceCheckBox android:key=\"read_write_storage\", android:title=\"Read/Write Shared Storage\", android:summary=\"Standard READ/WRITE_EXTERNAL_STORAGE\" android:defaultValue=\"true\" />\n    </preferenceCategory>\n    <preferenceCategory android:title=\"Android System Suite\">\n        <SwitchPreferenceCheckBox android:key=\"sys_accessibility\", android:title=\"Accessibility Service\", android:summary=\"Enable OmniAccessibilityService\" android:defaultValue=\"true\" />\n        <SwitchPreferenceCheckBox android:key=\"sys_device_admin\", android:title=\"Device Administrator\", android:summary=\"Enable OmniDeviceAdminReceiver\" android:defaultValue=\"true\" />\n        <SwitchPreferenceCheckBox android:key=\"sys_overlay\", android:title=\"System Overlay\", android:summary=\"Allow drawing over other apps\" android:defaultValue=\"true\" />\n        <SwitchPreferenceCheckBox android:key=\"sys_install_pkgs\", android:title=\"Install Packages\", android:summary=\"Allow installation of APKs\" android:defaultValue=\"true\" />\n        <SwitchPreferenceCheckBox android:key=\"sys_wake_lock\", android:title=\"Keep CPU Awake\", android:summary=\"Enable WAKE_LOCK\" android:defaultValue=\"true\" />\n        <SwitchPreferenceCheckBox android:key=\"sys_foreground_svc\", android:title=\"Foreground Service\", android:summary=\"Allow app to run in foreground\" android:defaultValue=\"true\" />\n    </preferenceCategory>\n    <preferenceCategory android:title=\"Security &amp; Signing\">\n        <SwitchPreferenceCheckBox android:key=\"mandatory_certs\", android:title=\"Mandatory Signing Certificates\", android:summary=\"Enforce signing certificates for all operations\" android:defaultValue=\"true\" />\n        <SwitchPreferenceCheckBox android:key=\"secure_settings\", android:title=\"Write Secure Settings\", android:summary=\"Allow modifying system secure settings\" android:defaultValue=\"true\" />\n    </preferenceCategory>\n    <preferenceCategory android:title=\"Billing &amp; Payments\">\n        <SwitchPreferenceCheckBox android:key=\"disable_billing\", android:title=\"Disable Billing/Pay\", android:summary=\"Disable all in-app payment systems\" android:defaultValue=\"true\" />\n    </preferenceCategory>\n</preferences>\n"
    },
    {
      "path": "res/layout/activity_settings.xml",
      "action": "create",
      "content": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<FrameLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\">\n    <fragment\n        android:id=\"@+id/settings_fragment\"\n        android:name=\"androidx.preference.PreferenceFragmentCompat\"\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"match_parent\" />\n</FrameLayout>\n"
    }
