<?xml version="1.0" encoding="utf-8"?>
<!-- Sovereign Edge Panel: Samsung-style swipe-out edge panel.
     A slim handle sits on the right screen edge; tapping it expands the full
     settings panel (filled with our Sovereign settings actions). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/edge_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- Slim edge handle (always visible) -->
    <LinearLayout
        android:id="@+id/edge_handle"
        android:layout_width="14dp"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC1B1B1B"
        android:layout_gravity="center_vertical|end">

        <View
            android:layout_width="3dp"
            android:layout_height="40dp"
            android:background="#FF4FC3FF" />
    </LinearLayout>

    <!-- Expanded settings panel (hidden until handle tapped) -->
    <ScrollView
        android:id="@+id/edge_panel_expanded"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="#EE101010"
        android:padding="10dp"
        android:layout_gravity="center_vertical|end">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_category"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btn_open_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings" />

            <Button
                android:id="@+id/btn_enable_all_perms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_enable_all_perms_title" />

            <Button
                android:id="@+id/btn_manage_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_manage_storage_title" />

            <Button
                android:id="@+id/btn_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_overlay_title" />

            <Button
                android:id="@+id/btn_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_accessibility_title" />

            <Button
                android:id="@+id/btn_open_downloads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_open_downloads_title" />

            <Button
                android:id="@+id/btn_import_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_import_title" />

            <Button
                android:id="@+id/btn_export_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_export_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_billing_off_summary"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_signing_required_summary"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingTop="4dp" />

            <Button
                android:id="@+id/btn_collapse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sov_collapse_title" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
